# Environment Configuration
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_PATH=attendance.db

# Face Recognition
FACE_RECOGNITION_THRESHOLD=0.6
ENCODINGS_PATH=models/face_encodings.pkl

# Anti-Spoofing
EAR_THRESHOLD=0.25
LANDMARK_PREDICTOR_PATH=models/shape_predictor_68_face_landmarks.dat

# Mask Detection
MASK_MODEL_PATH=models/mask_detector.h5
MASK_CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Performance
MAX_WORKERS=4
FRAME_SKIP=1

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
